# Optional cloud sync (Supabase). Leave empty → the app stays purely local and
# the Account section in Settings is hidden.
# Copy to .env.local, fill in from Supabase → Project Settings → API, restart `npx expo start`.
# The anon / publishable key is meant to be public — row-level security protects the data.
# Never put the service_role / secret key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
